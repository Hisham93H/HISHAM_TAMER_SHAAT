# Copy this file to .env and fill in the keys for the sources you want.
# noon and Haraj (Saudi Arabia) need no keys. Countries with no live source
# show sample data.

PORT=3000

# Turn sources off, e.g. if noon always blocks your server: DISABLE_SOURCES=noon
DISABLE_SOURCES=

# eBay Browse API: create a Production keyset at https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Set to "sandbox" to use a Sandbox keyset and eBay's test listings.
EBAY_ENV=production

# SerpAPI key: turns on Amazon (amazon.sa and other Amazon stores) and Google Shopping.
# https://serpapi.com/manage-api-key
SERPAPI_KEY=

# AliExpress Affiliate API: create an app at https://openservice.aliexpress.com
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
# Optional: your AliExpress affiliate tracking ID, so links earn you commission.
ALIEXPRESS_TRACKING_ID=
