# Copy this file to .env and fill in the keys for the sources you want.
# noon and Haraj (Saudi Arabia) need no keys. Countries with no live source
# show sample data.

PORT=3000

# Turn sources off, e.g. if noon always blocks your server: DISABLE_SOURCES=noon
DISABLE_SOURCES=

# eBay Browse API: create a Production keyset at https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Set to "sandbox" to use a Sandbox keyset and eBay's test listings.
EBAY_ENV=production

# Google Shopping results through SerpAPI: https://serpapi.com/manage-api-key
SERPAPI_KEY=
